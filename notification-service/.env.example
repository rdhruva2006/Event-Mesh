# Copy this file to .env before running. Never commit the real .env.

PORT=4002
NODE_ENV=development

NATS_URL=nats://localhost:4222

NATS_STREAM_NAME=USER_EVENTS
NATS_SUBJECT_USER_CREATED=user.events.created

# Durable consumer name - lets this service resume from where it left
# off after a restart instead of re-processing or missing events.
NATS_DURABLE_NAME=notification-service-durable
