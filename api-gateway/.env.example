# Copy this file to .env before running. Never commit the real .env.

PORT=3000
NODE_ENV=development

# Must be identical to the JWT_SECRET in user-service/.env - the
# gateway verifies tokens issued by the User Service.
JWT_SECRET=replace_with_a_long_random_secret

# Overridden by docker-compose for inter-container DNS names.
USER_SERVICE_URL=http://localhost:4001
NOTIFICATION_SERVICE_URL=http://localhost:4002
