# Copy this file to .env and fill in real values before running.
# NEVER commit the actual .env file to version control.

PORT=4001
NODE_ENV=development

# Symmetric secret used to sign/verify JWTs. Must match the value
# used by the API Gateway. Use a long, random string in production
# (e.g. `openssl rand -hex 64`) and inject it via a secrets manager.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# NATS connection (overridden by docker-compose for inter-container DNS)
NATS_URL=nats://localhost:4222

# JetStream stream/subject configuration
NATS_STREAM_NAME=USER_EVENTS
NATS_SUBJECT_USER_CREATED=user.events.created

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12
